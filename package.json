{
	"name": "@melsloop/ml-components",
	"version": "0.0.1",
	"description": "Mel's Loop UI Components Library",
	"main": "dist/cjs/bundle.js",
	"module": "dist/esm/bundle.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rimraf dist && rollup -c",
		"dev": "rollup -c -w",
		"test": "jest",
		"lint": "eslint src",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"predeploy-storybook": "npm run build-storybook",
		"deploy-storybook": "gh-pages -d storybook-static",
		"format:check": "npx prettier --config .prettierrc --ignore-path .prettierignore --check src",
		"format": "npx prettier --config .prettierrc --ignore-path .prettierignore --write src"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melsloop/ml-components.git"
	},
	"author": "tomerlichtash",
	"license": "MIT",
	"keywords": [
		"ui",
		"components",
		"typescript",
		"react",
		"css-vars"
	],
	"bugs": {
		"url": "https://github.com/melsloop/ml-components/issues"
	},
	"homepage": "https://melsloop.github.io/ml-components",
	"peerDependencies": {
		"react": ">=16.8.0",
		"react-dom": ">=16.8.0"
	},
	"devDependencies": {
		"@babel/core": "^7.21.4",
		"@babel/preset-env": "^7.21.4",
		"@babel/preset-react": "^7.18.6",
		"@babel/preset-typescript": "^7.21.4",
		"@rollup/plugin-commonjs": "^24.0.1",
		"@rollup/plugin-node-resolve": "^15.0.2",
		"@rollup/plugin-replace": "^5.0.7",
		"@rollup/plugin-terser": "^0.4.0",
		"@rollup/plugin-typescript": "^11.1.0",
		"@storybook/addon-essentials": "8.2.9",
		"@storybook/addon-interactions": "8.2.9",
		"@storybook/addon-links": "8.2.9",
		"@storybook/addon-webpack5-compiler-babel": "^3.0.3",
		"@storybook/blocks": "8.2.9",
		"@storybook/react": "8.2.9",
		"@storybook/react-webpack5": "8.2.9",
		"@storybook/test": "^8.0.5",
		"@testing-library/react": "16.0.1",
		"@types/grecaptcha": "^3.0.9",
		"@types/jest": "^29.5.0",
		"@types/react": "18.3.5",
		"@typescript-eslint/eslint-plugin": "^5.57.1",
		"@typescript-eslint/parser": "^5.57.1",
		"babel-jest": "^29.5.0",
		"eslint": "^8.38.0",
		"eslint-plugin-react": "^7.32.2",
		"gh-pages": "^5.0.0",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^29.5.0",
		"jest-environment-jsdom": "^29.5.0",
		"prop-types": "^15.8.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"rimraf": "^4.4.1",
		"rollup": "^3.20.2",
		"rollup-plugin-dts": "^5.3.0",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"rollup-plugin-postcss": "^4.0.2",
		"storybook": "^8.0.5",
